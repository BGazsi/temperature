# Sensor Configuration
use_real_sensor=false
SENSOR_TYPE=22
SENSOR_PIN=4
refresh_interval=60000

# API Configuration (NEW - replaces direct database access)
API_URL=http://localhost:443
API_KEY=your_api_key_here
API_TIMEOUT=10000

# Legacy Database Configuration (kept for reference, not used in API mode)
# MONGODB_URL=mongodb://localhost:27017
# MONGODB_DB_NAME=temperature_db
# MONGODB_COLLECTION=temperatures

# Application Configuration
LOG_LEVEL=info
MAX_BUFFER_SIZE=1000
MAX_CONSECUTIVE_ERRORS=10